# ==========================================
# Database Configuration (PostgreSQL + pgvector)
# ==========================================
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/db_ai_drive
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/db_ai_drive
SYNC_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/db_ai_drive

# ==========================================
# Google Gemini AI API Key
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# Embedding Model Configuration
# ==========================================
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ==========================================
# Google OAuth 2.0 Credentials (for Google Drive access)
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ==========================================
# Security & Application Settings
# ==========================================
SECRET_KEY=change_this_to_a_random_secure_secret_string
FRONTEND_URL=http://localhost:3000

# ==========================================
# Optional: Tesseract OCR binary path for Windows (if not in PATH)
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
# ==========================================
TESSERACT_CMD=tesseract
